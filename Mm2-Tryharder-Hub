-- ========== ATIRAR NO ASSASSINO (COM PREDICT) ==========
local shootButtonRef = nil
local shootScreenGuiRef = nil
local shootButtonSize = 120

-- ===== VARIÁVEIS DE CACHE DO ASSASSINO =====
local cachedMurdererPos = nil
local cachedMurdererVel = nil
local cacheValid = false

-- ===== LOOP DE ATUALIZAÇÃO DO CACHE (POSIÇÃO + VELOCIDADE) =====
task.spawn(function()
    while true do
        if env.ShootMurderEnabled then
            local murderer = nil
            local roles = getRoles()
            for plrName, role in pairs(roles) do
                if role == "Murderer" then
                    murderer = Players:FindFirstChild(plrName)
                    break
                end
            end
            if murderer and murderer.Character then
                local hrp = murderer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    cachedMurdererPos = hrp.Position
                    cachedMurdererVel = hrp.Velocity
                    cacheValid = true
                else
                    local torso = murderer.Character:FindFirstChild("Torso") or murderer.Character:FindFirstChild("UpperTorso")
                    if torso then
                        cachedMurdererPos = torso.Position
                        cachedMurdererVel = Vector3.new(0,0,0)
                        cacheValid = true
                    else
                        cacheValid = false
                    end
                end
            else
                cacheValid = false
            end
        end
        task.wait(0.1) -- atualização rápida
    end
end)

-- ===== FUNÇÃO PARA OBTER A POSIÇÃO DO ASSASSINO (COM PREDICT) =====
local function getMurdererPosition()
    -- Se o cache estiver válido, usa ele
    if cacheValid and cachedMurdererPos then
        -- Aplica o Predict se estiver ativado
        if env.PredictEnabled then
            local tempoVoo = 0.12 -- tempo de voo do tiro (ajuste fixo)
            local posAtual = cachedMurdererPos
            local vel = cachedMurdererVel or Vector3.new(0,0,0)
            -- Previsão: posição atual + (velocidade * tempo de voo)
            local posPrevista = posAtual + (vel * tempoVoo)
            return posPrevista
        else
            -- Sem predict: usa a posição atual
            return cachedMurdererPos
        end
    end

    -- ===== FALLBACK (caso o cache esteja vazio) =====
    local murderer = nil
    local roles = getRoles()
    for plrName, role in pairs(roles) do
        if role == "Murderer" then
            murderer = Players:FindFirstChild(plrName)
            break
        end
    end
    if not murderer then return nil end
    local char = murderer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local pos = hrp.Position
        if env.PredictEnabled then
            local vel = hrp.Velocity
            local tempoVoo = 0.12
            pos = pos + (vel * tempoVoo)
        end
        return pos
    end
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if torso then return torso.Position end
    local head = char:FindFirstChild("Head")
    if head then return head.Position end
    return nil
end

-- ===== FUNÇÃO PARA ATIRAR =====
local function shootMurderer()
    if not Char then
        OrionLib:MakeNotification({
            Name = "Tryharder Hub",
            Content = "Personagem não carregado!",
            Image = "rbxassetid://7733658504",
            Time = 1
        })
        return
    end

    local gun = Char:FindFirstChild("Gun")
    if not gun then
        gun = LocalPlayer:FindFirstChild("Backpack"):FindFirstChild("Gun")
    end

    if not gun then
        OrionLib:MakeNotification({
            Name = "Tryharder Hub",
            Content = "Pegue uma arma!",
            Image = "rbxassetid://7733658504",
            Time = 1
        })
        return
    end

    local handle = gun:FindFirstChild("Handle")
    if not handle then
        OrionLib:MakeNotification({
            Name = "Tryharder Hub",
            Content = "Handle não encontrado!",
            Image = "rbxassetid://7733658504",
            Time = 1
        })
        return
    end

    local shootRemote = gun:FindFirstChild("Shoot")
    if not shootRemote or not shootRemote:IsA("RemoteEvent") then
        OrionLib:MakeNotification({
            Name = "Tryharder Hub",
            Content = "Remote 'Shoot' não encontrado!",
            Image = "rbxassetid://7733658504",
            Time = 1
        })
        return
    end

    -- Obtém a posição do assassino (com ou sem predict)
    local targetPos = getMurdererPosition()
    if not targetPos then
        OrionLib:MakeNotification({
            Name = "Tryharder Hub",
            Content = "Assassino não encontrado!",
            Image = "rbxassetid://7733658504",
            Time = 1
        })
        return
    end

    -- Dispara o tiro
    local originCF = handle.CFrame
    local targetCF = CFrame.new(targetPos)

    pcall(function()
        shootRemote:FireServer(originCF, targetCF)
    end)
end


    end
    if not knife then
        OrionLib:MakeNotification({
            Name = "Tryharder Hub",
            Content = "Você não é o Murder!",
            Image = "rbxassetid://7733658504",
            Time = 2
        })
        return
    end

    -- Obtém o Handle da faca (para usar no firetouchinterest)
    local handle = knife:FindFirstChild("Handle")
    if not handle then
        OrionLib:MakeNotification({
            Name = "Tryharder Hub",
            Content = "Handle da faca não encontrado!",
            Image = "rbxassetid://7733658504",
            Time = 2
        })
        return
    end

    -- Lista de jogadores vivos (exceto você)
    local playersToKill = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                table.insert(playersToKill, p)
            end
        end
    end

    if #playersToKill == 0 then
        OrionLib:MakeNotification({
            Name = "Tryharder Hub",
            Content = "Nenhum jogador vivo!",
            Image = "rbxassetid://7733658504",
            Time = 2
        })
        return
    end

    local killedCount = 0

    -- Mata cada jogador
    for _, p in ipairs(playersToKill) do
        local targetChar = p.Character
        if targetChar then
            local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
            if targetHRP then
                -- Usa firetouchinterest para simular o toque da faca
                pcall(function()
                    firetouchinterest(handle, targetHRP, 0) -- touch begin
                    task.wait(0.02)
                    firetouchinterest(handle, targetHRP, 1) -- touch end
                    killedCount = killedCount + 1
                end)
            end
        end
        task.wait(0.05) -- pequeno delay para não sobrecarregar
    end

    -- Notificação
    OrionLib:MakeNotification({
        Name = "Tryharder Hub",
        Content = "💀 " .. killedCount .. " jogadores mortos!",
        Image = "rbxassetid://7733658504",
        Time = 3
    })
end

